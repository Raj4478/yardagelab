# Canonical production origin (used for canonicals, sitemap and JSON-LD).
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://yardagelab.com

# Set to "false" to force noindex even on a production deploy.
# NEXT_PUBLIC_ALLOW_INDEX=false

# Enable the consent-choice UI before adding non-essential analytics/ad tags.
# Keep false until an actual optional tag provider is configured.
NEXT_PUBLIC_ENABLE_CONSENT_BANNER=false
