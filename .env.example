# Canonical production origin (used for canonicals, sitemap and JSON-LD).
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://yardagelab.me

# Set to "false" to force noindex even on a production deploy.
# NEXT_PUBLIC_ALLOW_INDEX=false

# Google Analytics 4 web-stream measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-G6KTTK1PLK

# Enable the consent-choice UI before loading non-essential analytics/ad tags.
NEXT_PUBLIC_ENABLE_CONSENT_BANNER=true
